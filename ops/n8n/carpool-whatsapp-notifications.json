        "language": "javaScript",
        "jsCode": "const cfg = $('Config').first().json;\nconst arr = $input.first().json;\nconst b = Array.isArray(arr) ? arr[0] : arr;\nif (!b) return [{ json: { skip: true } }];\n\nconst carName = `${b.car.make} ${b.car.model}`;\nconst reason = b.cancel_reason ? ` (reason: ${b.cancel_reason})` : '';\n\nconst out = [];\nfor (const role of ['owner', 'booker']) {\n  const p = b[role];\n  if (!p || !p.phone) continue;\n  const digits = p.phone.replace(/[^0-9]/g, '');\n  if (!digits) continue;\n  const intl = digits.startsWith('60') ? digits : ('60' + digits.replace(/^0/, ''));\n\n  const text = `\u274c *Booking cancelled*\n\nThe booking of the *${carName}* has been cancelled${reason}.\n\n${cfg.CARPOOL_PUBLIC_URL}/member/bookings/${b.id}`;\n\n  out.push({ json: { wa_id: `${intl}@c.us`, text, audience: role, booking_id: b.id } });\n}\nreturn out.length ? out : [{ json: { skip: true } }];\n"
      },
