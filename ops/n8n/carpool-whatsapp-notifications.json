        "jsCode": "const cfg = $('Config').first().json;\nconst arr = $input.first().json;\nconst b = Array.isArray(arr) ? arr[0] : arr;\nif (!b || !b.booker) return [{ json: { skip: true } }];\n\nconst phoneRaw = b.booker.phone || '';\nconst digits = phoneRaw.replace(/[^0-9]/g, '');\nif (!digits) return [{ json: { skip: true, reason: 'booker_no_phone' } }];\nconst intl = digits.startsWith('60') ? digits : ('60' + digits.replace(/^0/, ''));\n\nconst carName = `${b.car.make} ${b.car.model}${b.car.year ? ` (${b.car.year})` : ''}`;\nconst ownerName = b.owner?.full_name || 'The owner';\nconst ownerPhone = b.owner?.phone || '\u2014';\n\nconst fmtDate = (iso) => new Date(iso).toLocaleString('en-MY', {\n  timeZone: 'Asia/Kuala_Lumpur',\n  day: 'numeric', month: 'short'\n});\n\nconst text = `\ud83c\udf89 *Booking confirmed!*\n\n*${ownerName}* confirmed your booking of the *${carName}* for ${fmtDate(b.start_at)}\u2013${fmtDate(b.end_at)}.\n\n\ud83d\ude97 Pickup: ${b.pickup_area}\n\ud83d\udc64 Owner contact: ${ownerPhone}\n\nYour customer info has been shared with the owner. Coordinate handover details directly.\n\n${cfg.CARPOOL_PUBLIC_URL}/member/bookings/${b.id}`;\n\nreturn [{ json: { wa_id: `${intl}@c.us`, text, audience: 'requester', booking_id: b.id } }];\n"
