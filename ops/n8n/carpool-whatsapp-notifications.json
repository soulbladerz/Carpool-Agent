    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const cfg = $('Config').first().json;\nconst arr = $input.first().json;\nconst r = Array.isArray(arr) ? arr[0] : arr;\nif (!r) return [{ json: { skip: true, reason: 'request_not_found' } }];\nif (!r.car_id || !r.car || !r.car.owner) {\n  return [{ json: { skip: true, reason: 'not_direct_or_no_owner' } }];\n}\nconst phoneRaw = r.car.owner.phone || '';\nconst digits = phoneRaw.replace(/[^0-9]/g, '');\nif (!digits) return [{ json: { skip: true, reason: 'owner_no_phone' } }];\nconst intl = digits.startsWith('60') ? digits : ('60' + digits.replace(/^0/, ''));\n\nconst fmt = (iso) => new Date(iso).toLocaleString('en-MY', {\n  timeZone: 'Asia/Kuala_Lumpur',\n  day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit'\n});\n\nconst requesterName = r.requester?.full_name || 'A member';\nconst carName = `${r.car.make} ${r.car.model}${r.car.year ? ` (${r.car.year})` : ''}`;\nconst maxRate = r.max_daily_rate ? `RM ${Number(r.max_daily_rate).toFixed(2)}/day` : 'open';\n\nconst text = `\ud83d\ude97 *New direct request for your car*\n\nYour *${carName}* has been requested by *${requesterName}* for:\n\ud83d\udcc5 ${fmt(r.start_at)} \u2192 ${fmt(r.end_at)}\n\ud83d\udccd Pickup: ${r.pickup_area}\n\ud83d\udc65 ${r.passenger_count} passenger${r.passenger_count > 1 ? 's' : ''}\n\ud83d\udcb0 Max rate: ${maxRate}\n\nView & make an offer:\n${cfg.CARPOOL_PUBLIC_URL}/member/requests/${r.id}\n\nReply within 6h to keep the slot warm.`;\n\nreturn [{ json: { wa_id: `${intl}@c.us`, text, audience: 'owner', request_id: r.id } }];\n"
      },
