        "jsCode": "const cfg = $('Config').first().json;\nconst arr = $input.first().json;\nconst b = Array.isArray(arr) ? arr[0] : arr;\nif (!b || !b.owner) return [{ json: { skip: true } }];\n\nconst phoneRaw = b.owner.phone || '';\nconst digits = phoneRaw.replace(/[^0-9]/g, '');\nif (!digits) return [{ json: { skip: true, reason: 'owner_no_phone' } }];\nconst intl = digits.startsWith('60') ? digits : ('60' + digits.replace(/^0/, ''));\n\nconst carName = `${b.car.make} ${b.car.model}${b.car.year ? ` (${b.car.year})` : ''}`;\nconst bookerName = b.booker?.full_name || 'A member';\n\nconst text = `\u2705 *Your offer was accepted!*\n\n*${bookerName}* accepted your offer of the *${carName}*.\n\n\u23f3 Please confirm or decline within 6 hours, otherwise the booking releases automatically.\n\n${cfg.CARPOOL_PUBLIC_URL}/member/bookings/${b.id}`;\n\nreturn [{ json: { wa_id: `${intl}@c.us`, text, audience: 'owner', booking_id: b.id } }];\n"
