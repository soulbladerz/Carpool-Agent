      "parameters": {
        "language": "javaScript",
        "jsCode": "const cfg = $('Config').first().json;\nconst arr = $input.first().json;\nconst o = Array.isArray(arr) ? arr[0] : arr;\nif (!o || !o.request || !o.request.requester) return [{ json: { skip: true } }];\n\nconst phoneRaw = o.request.requester.phone || '';\nconst digits = phoneRaw.replace(/[^0-9]/g, '');\nif (!digits) return [{ json: { skip: true, reason: 'requester_no_phone' } }];\nconst intl = digits.startsWith('60') ? digits : ('60' + digits.replace(/^0/, ''));\n\nconst carName = `${o.car.make} ${o.car.model}${o.car.year ? ` (${o.car.year})` : ''}`;\nconst offererName = o.offerer?.full_name || 'A member';\nconst note = (o.notes || '').trim();\nconst noteLine = note ? `\\n\ud83d\udcdd \"${note}\"` : '';\n\nconst text = `\ud83d\udce9 *New offer on your request*\n\n*${offererName}* offered their *${carName}* for your trip to ${o.request.pickup_area}.\n\ud83d\udcb0 RM ${Number(o.daily_rate).toFixed(2)}/day \u00b7 RM ${Number(o.deposit).toFixed(2)} deposit${noteLine}\n\nReview & accept:\n${cfg.CARPOOL_PUBLIC_URL}/member/requests/${o.request.id}`;\n\nreturn [{ json: { wa_id: `${intl}@c.us`, text, audience: 'requester', offer_id: o.id } }];\n"
      },
